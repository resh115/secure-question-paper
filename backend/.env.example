# MongoDB Atlas
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/et_hackathon?appName=Cluster0
DATABASE_NAME=et_hackathon

# Backblaze B2
B2_KEY_ID=YOUR_B2_KEY_ID
B2_APPLICATION_KEY=YOUR_B2_APPLICATION_KEY
B2_BUCKET_NAME=secure-question-paper-shares

# Firebase Admin SDK
# Put the path to the downloaded Firebase service-account JSON file.
FIREBASE_SERVICE_ACCOUNT=firebase-service-account.json
